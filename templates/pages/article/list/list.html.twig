{% extends 'layouts/admin.base.html.twig' %}

{% block body %}
<div class="container mt-4">

  {% include 'components/alert/_alert-messages.html.twig' %}

  <!-- HEADER + ADD BUTTON -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Articles List</h3>
    <a href="{{ path('article.create') }}" class="btn btn-primary">+ Add Article</a>
  </div>

  <!-- SEARCH BAR -->
  <div class="input-group mb-3">
    <input type="text" class="form-control bg-dark text-light border-secondary" placeholder="Search an article...">
    <button class="btn btn-outline-secondary" type="button">Search</button>
  </div>

  <!-- ARTICLES TABLE -->
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <table class="table table-dark table-hover mb-0 table-dark-custom table-responsive-sm">
        <thead>
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Author</th>
          <th>Date</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for article in articles %}
          <tr>
            <td>{{ article.id }}</td>
            <td>{{ article.title }}</td>
            <td>Admin</td>
            <td>2025-01-15</td>
            <td>
              {% if article.status is same as(enum('App\\Article\\Domain\\Model\\Enum\\ArticleStatus').Published) %}
                <span class="badge bg-success">Published</span>
              {% else %}
                <span class="badge bg-secondary">Draft</span>
              {% endif %}
            </td>
            <td class="text-end">
              <button class="btn btn-sm btn-info">View</button>
              <a href="{{ path('article.edit', {id: article.id}) }}" class="btn btn-sm btn-warning">Edit</a>
              <button class="btn btn-sm btn-danger">Delete</button>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% endblock %}
