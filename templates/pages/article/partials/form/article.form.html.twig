</div>
<div class="form-group mb-3">
  {{ form_label(form.content) }}
  {{ form_widget(form.content) }}
</div>
<div class="form-group mb-3">
  {{ form_label(form.taxonomies) }}
  {{ form_widget(form.taxonomies) }}
</div>
